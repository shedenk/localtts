# === Server ===
APP_NAME=LocalTTS
HOST=0.0.0.0
PORT=8000

# === UI Authentication (.env) ===
# Kosongkan AUTH_USERNAME atau AUTH_PASSWORD jika ingin UI tanpa login
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme123
SESSION_SECRET=change-this-to-a-long-random-secret-key

# === API Security Header (.env) ===
# Kosongkan API_KEY jika API ingin diakses bebas tanpa header pengamanan
# Jika diisi, client harus kirim: Authorization: Bearer <API_KEY> atau X-API-Key: <API_KEY>
API_KEY=
API_KEY_HEADER=X-API-Key

# === Access Control Whitelist (IP & Domain) ===
# Kosongkan jika ingin mengizinkan semua IP / domain (endpoint /health selalu diizinkan)
# Mendukung IP tunggal & CIDR subnet, dipisah koma: 127.0.0.1,::1,103.10.20.30,192.168.1.0/24
ALLOWED_IPS=
# Mendukung domain & wildcard subdomain, dipisah koma: tts.myminio.cloud,app.domain.com,*.domain.com
ALLOWED_DOMAINS=

# === Hardware & Engine ===
# auto | cuda | mps | cpu
DEVICE=auto
# Engine yang diaktifkan (koma-separated): kokoro,edge,whisper,omnivoice,qwen3
ENABLED_ENGINES=kokoro,edge,whisper,omnivoice,qwen3
# Otomatis unload model dari RAM/VRAM setelah idle (detik). 0 = jangan unload
IDLE_UNLOAD_SECONDS=300

# === Limits (0 = unlimited) ===
TTS_MAX_CHARS=5000
STT_MAX_FILE_MB=50

# === Default Webhook (opsional) ===
WEBHOOK_URL=
# Izinkan URL localhost/127.0.0.1 untuk testing lokal/Docker (set false di VPS publik ketat)
ALLOW_LOCAL_URLS=true

# === Storage ===
DATA_DIR=./data
MODELS_DIR=./models

# === Storage Auto-Cleanup & System Logs Policy ===
# Ambang batas pemakaian disk (%) untuk trigger auto-clean (default: 75)
AUTO_CLEAN_DISK_PERCENT=75
# Hapus otomatis file audio output lama yang berumur lebih dari sekian hari (default: 30)
AUTO_CLEAN_RETENTION_DAYS=30
# Retensi log sistem (hari) sebelum otomatis dibersihkan (default: 3)
LOG_RETENTION_DAYS=3
# Batas maksimal ukuran file log (MB) sebelum dirotasi (default: 10)
LOG_MAX_MB=10

# === Default Model Settings ===
WHISPER_DEFAULT_MODEL=base
QWEN3_MODEL_ID=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
OMNIVOICE_MODEL_ID=k2-fsa/OmniVoice
